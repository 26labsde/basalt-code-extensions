{
  "id": "basalt.gdscript",
  "name": "GDScript",
  "version": "1.0.0",
  "description": "Syntaxhervorhebung für GDScript (Godot).",
  "author": "Basalt Code",
  "license": "MIT",
  "kind": "language",
  "language": {
    "id": "gdscript",
    "name": "GDScript",
    "fileExtensions": ["gd"],
    "keywords": ["and", "as", "await", "break", "class", "class_name", "const", "continue", "elif", "else", "enum", "export", "extends", "false", "for", "func", "if", "in", "is", "match", "not", "null", "onready", "or", "pass", "preload", "return", "self", "signal", "static", "super", "true", "var", "void", "while", "yield"],
    "lineComment": "#",
    "stringDelimiters": ["\"", "'"],
    "bracketIndent": false
  }
}
